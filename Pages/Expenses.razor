@page "/expenses"
@inject ExpenseService ExpSvc
@inject NavigationManager Nav

<PageTitle>Expenses – FinTrack</PageTitle>

@if (!AppState.IsLoggedIn) { Nav.NavigateTo("/login"); return; }

<div class="page-header mb-4 d-flex justify-content-between align-items-start flex-wrap gap-2">
    <div>
        <h1 class="fw-bold mb-1">Expenses</h1>
        <p class="text-muted mb-0">Track and manage your spending</p>
    </div>
    <button class="btn btn-primary" @onclick="OpenAddModal">
        <i class="bi bi-plus-lg me-1"></i>Add Expense
    </button>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-sm-4">
                <label class="form-label small fw-medium">Month</label>
                <select class="form-select form-select-sm" @bind="_filterMonth">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m">@(new DateTime(2000, m, 1).ToString("MMMM"))</option>
                    }
                </select>
            </div>
            <div class="col-sm-3">
                <label class="form-label small fw-medium">Year</label>
                <select class="form-select form-select-sm" @bind="_filterYear">
                    @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 2; y--)
                    {
                        <option value="@y">@y</option>
                    }
                </select>
            </div>
            <div class="col-sm-3">
                <label class="form-label small fw-medium">Category</label>
                <select class="form-select form-select-sm" @bind="_filterCategory">
                    <option value="">All Categories</option>
                    @foreach (var c in ExpenseService.Categories)
                    {
                        <option value="@c">@c</option>
                    }
                </select>
            </div>
            <div class="col-sm-2">
                <button class="btn btn-outline-primary btn-sm w-100" @onclick="LoadExpenses">
                    <i class="bi bi-funnel me-1"></i>Filter
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Summary -->
<div class="d-flex gap-3 mb-3 flex-wrap">
    <span class="badge bg-danger-subtle text-danger fs-6 rounded-pill px-3 py-2">
        <i class="bi bi-arrow-down-circle me-1"></i>Total: $@_filtered.Sum(e => e.Amount).ToString("N2")
    </span>
    <span class="badge bg-secondary-subtle text-secondary fs-6 rounded-pill px-3 py-2">
        @_filtered.Count transaction(s)
    </span>
</div>

<!-- Expenses Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (!_filtered.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1"></i>
                <p class="mt-3 mb-1 fw-medium">No expenses found</p>
                <p class="small">Try adjusting your filters or add a new expense.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Date</th>
                            <th>Notes</th>
                            <th class="text-end">Amount</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in _filtered)
                        {
                            <tr>
                                <td class="fw-medium">@e.Title</td>
                                <td><span class="badge bg-secondary-subtle text-secondary">@e.Category</span></td>
                                <td class="text-muted small">@e.Date.ToString("MMM d, yyyy")</td>
                                <td class="text-muted small">@(e.Notes.Length > 30 ? e.Notes[..30] + "..." : e.Notes)</td>
                                <td class="text-end fw-bold text-danger">$@e.Amount.ToString("N2")</td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => OpenEditModal(e)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(e)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Add/Edit Modal -->
@if (_showModal)
{
    <div class="modal-backdrop show"></div>
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold">@(_editingId == 0 ? "Add Expense" : "Edit Expense")</h5>
                    <button class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-medium">Title *</label>
                        <input class="form-control" @bind="_form.Title" placeholder="e.g. Grocery shopping" />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-medium">Amount (USD) *</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input class="form-control" type="number" step="0.01" min="0" @bind="_form.Amount" />
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-medium">Category</label>
                            <select class="form-select" @bind="_form.Category">
                                @foreach (var c in ExpenseService.Categories)
                                {
                                    <option value="@c">@c</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium">Date</label>
                        <input class="form-control" type="date" @bind="_form.Date" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium">Notes</label>
                        <textarea class="form-control" rows="2" @bind="_form.Notes" placeholder="Optional notes..."></textarea>
                    </div>
                    @if (!string.IsNullOrEmpty(_formError))
                    {
                        <div class="alert alert-danger py-2">@_formError</div>
                    }
                </div>
                <div class="modal-footer border-0">
                    <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveExpense">
                        <i class="bi bi-check-lg me-1"></i>@(_editingId == 0 ? "Add" : "Save")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Delete Confirm Modal -->
@if (_deleteTarget != null)
{
    <div class="modal-backdrop show"></div>
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow">
                <div class="modal-body text-center p-4">
                    <i class="bi bi-exclamation-triangle text-danger fs-1"></i>
                    <p class="fw-semibold mt-2 mb-1">Delete this expense?</p>
                    <p class="text-muted small">"@_deleteTarget.Title" – $@_deleteTarget.Amount.ToString("N2")</p>
                </div>
                <div class="modal-footer border-0 justify-content-center">
                    <button class="btn btn-secondary btn-sm" @onclick="() => _deleteTarget = null">Cancel</button>
                    <button class="btn btn-danger btn-sm" @onclick="DeleteExpense">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Expense> _expenses = new();
    private List<Expense> _filtered = new();
    private int _filterMonth = DateTime.Now.Month;
    private int _filterYear = DateTime.Now.Year;
    private string _filterCategory = string.Empty;

    private bool _showModal = false;
    private int _editingId = 0;
    private ExpenseForm _form = new();
    private string _formError = string.Empty;
    private Expense? _deleteTarget;

    protected override async Task OnInitializedAsync() => await LoadExpenses();

    private async Task LoadExpenses()
    {
        _expenses = await ExpSvc.GetExpensesAsync(AppState.CurrentUser!.Id, _filterMonth, _filterYear);
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        _filtered = string.IsNullOrEmpty(_filterCategory)
            ? _expenses
            : _expenses.Where(e => e.Category == _filterCategory).ToList();
    }

    private void OpenAddModal()
    {
        _editingId = 0;
        _form = new ExpenseForm { Date = DateTime.Today };
        _formError = string.Empty;
        _showModal = true;
    }

    private void OpenEditModal(Expense e)
    {
        _editingId = e.Id;
        _form = new ExpenseForm { Title = e.Title, Amount = e.Amount, Category = e.Category, Date = e.Date, Notes = e.Notes };
        _formError = string.Empty;
        _showModal = true;
    }

    private void CloseModal() => _showModal = false;

    private async Task SaveExpense()
    {
        if (string.IsNullOrWhiteSpace(_form.Title)) { _formError = "Title is required."; return; }
        if (_form.Amount <= 0) { _formError = "Amount must be greater than 0."; return; }

        if (_editingId == 0)
        {
            await ExpSvc.AddExpenseAsync(new Expense
            {
                UserId = AppState.CurrentUser!.Id,
                Title = _form.Title, Amount = _form.Amount,
                Category = _form.Category, Date = _form.Date, Notes = _form.Notes
            });
            Toast.ShowSuccess("Expense added successfully!");
        }
        else
        {
            await ExpSvc.UpdateExpenseAsync(new Expense
            {
                Id = _editingId, UserId = AppState.CurrentUser!.Id,
                Title = _form.Title, Amount = _form.Amount,
                Category = _form.Category, Date = _form.Date, Notes = _form.Notes
            });
            Toast.ShowSuccess("Expense updated!");
        }

        _showModal = false;
        await LoadExpenses();
    }

    private void ConfirmDelete(Expense e) => _deleteTarget = e;

    private async Task DeleteExpense()
    {
        await ExpSvc.DeleteExpenseAsync(_deleteTarget!.Id);
        Toast.ShowSuccess("Expense deleted.");
        _deleteTarget = null;
        await LoadExpenses();
    }

    private class ExpenseForm
    {
        public string Title { get; set; } = string.Empty;
        public decimal Amount { get; set; }
        public string Category { get; set; } = "Other";
        public DateTime Date { get; set; } = DateTime.Today;
        public string Notes { get; set; } = string.Empty;
    }
}
