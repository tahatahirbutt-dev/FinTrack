@inherits LayoutComponentBase
@implements IDisposable

<ToastContainer />

@if (!AppState.IsLoggedIn)
{
    @Body
}
else
{
    <div class="d-flex" style="min-height:100vh">
        <!-- Sidebar -->
        <nav class="sidebar d-flex flex-column p-3">
            <div class="sidebar-brand mb-4">
                <i class="bi bi-wallet2 me-2"></i>FinTrack
            </div>
            <ul class="nav flex-column gap-1 flex-grow-1">
                <li class="nav-item">
                    <NavLink class="nav-link sidebar-link" href="/" Match="NavLinkMatch.All">
                        <i class="bi bi-speedometer2 me-2"></i>Dashboard
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link sidebar-link" href="/expenses">
                        <i class="bi bi-receipt me-2"></i>Expenses
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link sidebar-link" href="/budget">
                        <i class="bi bi-piggy-bank me-2"></i>Budget
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link sidebar-link" href="/currency">
                        <i class="bi bi-currency-exchange me-2"></i>Currency
                    </NavLink>
                </li>
            </ul>
            <!-- User info at bottom -->
            <div class="sidebar-footer mt-auto pt-3 border-top border-secondary">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="avatar-circle">@AppState.CurrentUser!.Name[0]</div>
                    <div>
                        <div class="fw-semibold text-white small">@AppState.CurrentUser.Name</div>
                        <div class="text-secondary" style="font-size:0.75rem">@AppState.CurrentUser.Email</div>
                    </div>
                </div>
                <button class="btn btn-outline-secondary btn-sm w-100" @onclick="Logout">
                    <i class="bi bi-box-arrow-right me-1"></i>Logout
                </button>
            </div>
        </nav>

        <!-- Main content -->
        <main class="main-content flex-grow-1 p-4">
            @Body
        </main>
    </div>
}

@code {
    protected override void OnInitialized()
        => AppState.OnChange += StateHasChanged;

    private void Logout()
    {
        AppState.Logout();
        Toast.ShowInfo("Logged out successfully.");
    }

    public void Dispose()
        => AppState.OnChange -= StateHasChanged;
}
